# Desarrollo en navegador en esta misma PC. Para Android, reemplaza por
# 10.0.2.2 (emulador) o la IPv4 de esta PC (dispositivo físico).
VITE_API_URL=http://localhost:5171/api
# Permite HTTP a IPs privadas solo desde Android nativo.
VITE_ALLOW_INSECURE_LOCAL_API=false
# Dirección oficial del sanatorio para abrir "Cómo llegar" (opcional).
VITE_SANATORIO_DIRECCION=
